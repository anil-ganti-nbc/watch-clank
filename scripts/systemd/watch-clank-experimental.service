[Unit]
Description=Watch Clank experimental brand discovery (Citizen, Seiko)

[Service]
Type=oneshot
WorkingDirectory=/opt/watch-clank
EnvironmentFile=-/opt/watch-clank/.env
ExecStart=/opt/watch-clank/.venv/bin/python -m scripts.run_pipeline --experimental-brand citizen
# Isolated overlap protection (own lock file + collector_id) means this can
# safely be scheduled independently of watch-clank.service; it cannot
# collide with the Casio production run.
SuccessExitStatus=0
