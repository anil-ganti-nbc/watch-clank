[Unit]
Description=Run Watch Clank's EXPERIMENTAL Timex news lane every 90 minutes

[Timer]
# Matches the Windows Task Scheduler cadence (WatchClank-TimexNews, 90 min --
# see scripts/install_windows_timex_tasks.ps1). Sprint 11's miss autopsy
# confirmed this cadence catches a real launch same-day (see
# ai/handoff/TIMEX_MISS_AUTOPSY.md) once the SKU-extraction fix landed.
OnBootSec=10min
OnUnitActiveSec=90min
Persistent=true

[Install]
WantedBy=timers.target
