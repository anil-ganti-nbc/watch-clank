[Unit]
Description=Watch Clank EXPERIMENTAL Casioblog specialist early-warning lane

[Service]
Type=oneshot
WorkingDirectory=/opt/watch-clank
EnvironmentFile=-/opt/watch-clank/.env
ExecStart=/opt/watch-clank/.venv/bin/python -m scripts.run_pipeline --experimental-specialist casioblog
# Isolated overlap protection (own lock file + collector_id "casioblog_rss")
# means this can safely run independently of every other unit in this
# directory -- none of them can collide.
SuccessExitStatus=0
