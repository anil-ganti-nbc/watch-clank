[Unit]
Description=Run Watch Clank's EXPERIMENTAL Citizen Germany product sitemap-delta lane every 12 hours

[Timer]
# The first run is an explicit, silent source-scoped baseline. Later runs
# fetch only new sitemap URLs, so a 12-hour cadence yields at most the sitemap
# request when the official catalogue is unchanged.
OnBootSec=25min
OnUnitActiveSec=12h
Persistent=true

[Install]
WantedBy=timers.target
