[Unit]
Description=Run Watch Clank's experimental Citizen news-discovery lane periodically

[Timer]
# Deliberately independent of watch-clank.timer's schedule. A shorter/longer
# interval here does not affect Casio production cadence in any way.
OnBootSec=10min
OnUnitActiveSec=90min
Persistent=true

[Install]
WantedBy=timers.target
