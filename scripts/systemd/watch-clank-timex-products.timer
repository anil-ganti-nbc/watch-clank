[Unit]
Description=Run Watch Clank's EXPERIMENTAL Timex product/catalogue lane every 6 hours

[Timer]
# Matches the Windows Task Scheduler cadence (WatchClank-TimexProducts,
# 360 min -- see scripts/install_windows_timex_tasks.ps1).
OnBootSec=30min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
