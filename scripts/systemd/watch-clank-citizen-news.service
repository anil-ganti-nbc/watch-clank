[Unit]
Description=Watch Clank EXPERIMENTAL Citizen news discovery

[Service]
Type=oneshot
WorkingDirectory=/opt/watch-clank
EnvironmentFile=-/opt/watch-clank/.env
ExecStart=/opt/watch-clank/.venv/bin/python -m scripts.run_pipeline --experimental-brand citizen
# Isolated overlap protection (own lock file + collector_id "citizen_news")
# means this can safely run independently of watch-clank.service (Casio) and
# every other unit in this directory — none of them can collide.
SuccessExitStatus=0
