#!/usr/bin/env bash
# Launch the Watch Clank dashboard locally, bound to localhost only, using
# an isolated local-dev database/snapshot store (never production/Hetzner state).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/python" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

PORT="${WATCH_CLANK_MAC_PORT:-8918}"
mkdir -p .mac-dev/data/snapshots .mac-dev/logs

export DATABASE_URL="sqlite:///${REPO_ROOT}/.mac-dev/data/watch_clank.db"
export SNAPSHOT_STORAGE_ROOT="${REPO_ROOT}/.mac-dev/data/snapshots"
export LOG_DIR="${REPO_ROOT}/.mac-dev/logs"
export APP_HOST="127.0.0.1"
export APP_PORT="$PORT"

.venv/bin/python -m alembic upgrade head >/dev/null

echo "==> Local dev DB:  .mac-dev/data/watch_clank.db"
echo "==> Dashboard:      http://127.0.0.1:${PORT}/"
echo "==> Health:         http://127.0.0.1:${PORT}/health"
echo "    (Ctrl+C to stop)"
echo ""

exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$PORT"
