# DRAFT — architecture planning artifact only. NOT built, NOT tested, NOT to be
# used to deploy Watch Clank. See ai/handoff/CLOUD_READINESS_BLOCKERS.md.
#
# Watch Clank is Tier D (architecture-preparation-only) in the cloud migration
# project. Its own HANDOFF.md (2026-08-08) explicitly says "do not start Stage 2
# — continue soak test." Do not `docker build` this file. Do not run it against
# the live soak DB (data/watch_clank.db) or live snapshot store (data/snapshots/).
#
# This single image is intended to serve BOTH draft services sketched in
# docker-compose.draft.yml:
#   - `pipeline`  : one-shot `python -m scripts.run_pipeline --scheduled`,
#                   meant to be invoked by an external scheduler (cron/Task
#                   Scheduler equivalent) and exit — no long-running process.
#   - `dashboard` : long-running `uvicorn app.main:app`, read-only web UI,
#                   optional, loopback/private-network only.
# Same image, different CMD per service (see compose file).

FROM python:3.12-slim AS base

# --- OS deps -----------------------------------------------------------
# selectolax/httpx are pure-wheel on manylinux for common platforms; no extra
# system packages identified as required during this audit. Revisit if a
# real build ever surfaces a missing shared lib (e.g. for lxml fallbacks).
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
    && rm -rf /var/lib/apt/lists/*

# --- Non-root user -------------------------------------------------------
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin watchclank

WORKDIR /app

# --- Python deps -----------------------------------------------------------
COPY pyproject.toml ./
# NOTE (draft): pip install -e . needs the package source present for
# hatchling to resolve; copying pyproject alone here is illustrative of layer
# ordering, not a working build step. A real Dockerfile would copy app/ first
# or use a lockfile-based two-stage install for better layer caching.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
COPY scripts ./scripts

RUN pip install --no-cache-dir .

# --- Runtime paths ---------------------------------------------------------
# DATABASE_URL and SNAPSHOT_STORAGE_ROOT should be set (via env/.env or
# compose) to paths under the mounted volume, e.g.:
#   DATABASE_URL=sqlite:////data/watch_clank.db
#   SNAPSHOT_STORAGE_ROOT=/data/snapshots
#   LOG_DIR=/data/logs
# Both data/watch_clank.db (Alembic-versioned SQLite, WAL mode) and
# data/snapshots/ (content-addressed evidence blobs) are authoritative state,
# not caches — they MUST live on a persistent volume, not container-local FS.
RUN mkdir -p /data && chown -R watchclank:watchclank /data /app
VOLUME ["/data"]

USER watchclank

ENTRYPOINT ["/usr/bin/tini", "--"]

# Default CMD is the one-shot pipeline job (the "preferred" pattern for this
# app). The dashboard service overrides CMD in compose.
CMD ["python", "-m", "scripts.run_pipeline", "--scheduled"]

# --- Migrations note (draft, do not implement) ------------------------------
# Alembic migrations are NOT run automatically by this image. The soak-day
# outage documented in HANDOFF.md (2026-08-08: DB pinned at 002_ops_statuses
# while code was at 003_release_leads, causing every scheduled run to fail)
# happened precisely because `alembic upgrade head` was a manual, easy-to-skip
# step. Any real containerization must decide *deliberately* whether migration
# application is:
#   (a) a separate one-shot "migrate" invocation of this same image
#       (`alembic upgrade head`) run by the external scheduler/operator before
#       first pipeline run after a deploy, or
#   (b) an explicit startup check (not auto-migrate) that refuses to run and
#       exits non-zero if the DB schema is behind head.
# This draft does not choose between them — flagged as an open decision in
# CLOUD_READINESS_BLOCKERS.md.
