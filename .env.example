# Watch Clank Stage 1 configuration

# Database
DATABASE_URL=sqlite:///./data/watch_clank.db

# Snapshot storage
SNAPSHOT_STORAGE_ROOT=./data/snapshots
SNAPSHOT_MAX_PAYLOAD_BYTES=10485760
SNAPSHOT_COMPRESSION=gzip

# Collector settings
COLLECTOR_USER_AGENT=WatchClank/0.1.0 (+https://github.com/example/watch-clank; editorial-research)
COLLECTOR_TIMEOUT_SECONDS=30
COLLECTOR_MAX_RETRIES=3
COLLECTOR_BACKOFF_BASE=1.0
COLLECTOR_JITTER=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# App
APP_HOST=127.0.0.1
APP_PORT=8765
DEBUG=false

# Operations
SCHEDULE_INTERVAL_MINUTES=90
STALE_RUN_THRESHOLD_MINUTES=45
MAX_RUN_DURATION_SECONDS=1200
LOG_DIR=./data/logs
