# Watch Clank Stage 1 configuration

# Database
DATABASE_URL=sqlite:///./data/watch_clank.db

# Snapshot storage
SNAPSHOT_STORAGE_ROOT=./data/snapshots
SNAPSHOT_MAX_PAYLOAD_BYTES=10485760
SNAPSHOT_COMPRESSION=gzip

# Collector settings
COLLECTOR_USER_AGENT=WatchClank/0.1.0 (+https://github.com/example/watch-clank; editorial-research)
COLLECTOR_TIMEOUT_SECONDS=30
COLLECTOR_MAX_RETRIES=3
COLLECTOR_BACKOFF_BASE=1.0
COLLECTOR_JITTER=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# App
APP_HOST=127.0.0.1
APP_PORT=8765
DEBUG=false

# Operations
SCHEDULE_INTERVAL_MINUTES=90
STALE_RUN_THRESHOLD_MINUTES=45
MAX_RUN_DURATION_SECONDS=1200
LOG_DIR=./data/logs

# Discord alert delivery (Sprint 2). Leave unset to disable — the notifier
# is a safe no-op without these. Never commit real values.
# DISCORD_EDITORIAL_WEBHOOK_URL=
# DISCORD_HEALTH_WEBHOOK_URL=
# Editorial authority is single-host. Keep true for the current Windows field
# test; set false on Windows once Hetzner becomes the authoritative sender.
EDITORIAL_NOTIFICATIONS_ENABLED=true
# Minimum editorial score (0-100) to alert from the EXPERIMENTAL brand lane.
# Deliberately low by default during tuning — see HANDOFF.md Sprint 2.
DISCORD_EXPERIMENTAL_MIN_SCORE=0
# Minimum editorial score (0-100) to alert from the OFFICIAL/production lane
# (Casio). 50 matches score_event's own HIGH-confidence cutoff — deliberately
# stricter than the experimental lane. See
# ai/handoff/INCIDENT_SILENT_SCHEDULED_NOTIFICATIONS.md for why this used to
# be an unreachable hardcoded 100.
DISCORD_OFFICIAL_MIN_SCORE=50

# Web catch-up sprint: which deployment this is. The web UI displays this
# prominently so nobody mistakes one independent database for the other.
# Never inferred from hostname. Leave unset and the UI honestly shows
# "UNLABELED" rather than guessing.
# WATCH_CLANK_INSTANCE=WINDOWS FIELD TEST
# WATCH_CLANK_INSTANCE=HETZNER
